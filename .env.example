# Development environment variable template.
# Copiar a .env y completar los valores reales antes de levantar el proyecto.
# Ver docs/instalacion.md para el detalle de cada variable y cómo conseguirlas.

PORT=3000
NODE_ENV=development

# Postgres local (ver docker-compose.yml) — no hace falta tocarla si usás el docker-compose incluido
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookings?schema=public"

FRONTEND_URL="http://localhost:5173"
# URL pública (ngrok u otro túnel) apuntando a tu localhost:3000, para que MercadoPago
# pueda pegarle al webhook. Ver docs/instalacion.md.
BACKEND_URL="https://REPLACE.ngrok-free.dev"

# Podés generar valores random con: node -e "console.log(crypto.randomUUID())"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_SECRET"

# Credenciales de TEST de tu cuenta de MercadoPago (developers.mercadopago.com.ar)
MERCADOPAGO_ACCESS_TOKEN="REPLACE"
# Opcional pero recomendado: habilita la validación de firma del webhook
MERCADOPAGO_WEBHOOK_SECRET="REPLACE"

# Credenciales de tu cuenta de Cloudinary (cloudinary.com)
CLOUDINARY_CLOUD_NAME="REPLACE"
CLOUDINARY_API_KEY="REPLACE"
CLOUDINARY_API_SECRET="REPLACE"

# Cuenta de Gmail + contraseña de aplicación (myaccount.google.com/apppasswords)
# usada por Nodemailer para el mail de recuperación de contraseña
GOOGLE_APP_USER="REPLACE@gmail.com"
GOOGLE_APP_PASSWORD="REPLACE"
# Remitente que figura en ese mail — normalmente el mismo que GOOGLE_APP_USER
EMAIL_FROM="REPLACE@gmail.com"
